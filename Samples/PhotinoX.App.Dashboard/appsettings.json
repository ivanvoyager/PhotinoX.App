{
  "PhotinoX": {
    "ApplicationName": "PhotinoX.App Dashboard",
    "WebRootPath": "wwwroot",

    "WindowDefaults": {
      "Window": {
        "CenterOnInitialize": true,
        "Resizable": true
      },
      "Browser": {
        "ContextMenuEnabled": true,
        "DevToolsEnabled": true
      }
    },

    "MainWindow": {
      "Window": {
        "Title": "PhotinoX.App Dashboard",
        "Width": 980,
        "Height": 680,
        "StartUrl": "main.html"
      }
    },

    "Windows": {
      "Details": {
        "Window": {
          "Title": "Runtime Details",
          "Width": 940,
          "Height": 720,
          "StartUrl": "details.html"
        }
      }
    },

    "Runtime": {
      "WebView2RuntimePath": null
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}